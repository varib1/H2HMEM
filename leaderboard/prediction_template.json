{
  // ============================================
  // H2HMem Leaderboard Submission Template
  // ============================================
  // 
  // The root object contains a single key "predictions",
  // which is an array of predictions.
  //
  // Both prediction_dyadic.json and prediction_multi_party.json
  // should follow this structure.
  //
  // ============================================
  //
  // Each prediction object contains the following fields:
  //
  // - question_text (string, required):
  //     The text content of the question asked to the system.
  //     Example: "What is the capital of France?"
  //
  // - question_image (string, optional):
  //     Path or URL to an image accompanying the question.
  //     Use empty string "" if no image is associated.
  //     Example: "1.jpg" or ""
  //
  // - system_answer (string, required):
  //     The answer generated by your system/method.
  //     This is the prediction that will be evaluated.
  //     Example: "The capital of France is Paris."
  //
  // - original_answer (string, required):
  //     The ground truth answer for reference.
  //     Used for evaluation against your system's prediction.
  //     Example: "Paris"
  //
  // - category (string, required):
  //     The category of the question.
  //     Example: "Unimodal Precise Recall", etc.
  //
  // ============================================

  "predictions": [
    {
      "question_text": "",
      "question_image": "",
      "system_answer": "",
      "original_answer": "",
      "category": ""
    },
    {
      "question_text": "",
      "question_image": "",
      "system_answer": "",
      "original_answer": "",
      "category": ""
    }
    // ... more predictions
  ]
}
